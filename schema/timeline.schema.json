{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Research Timeline",
  "description": "Schema for documenting research timelines from first AI interaction to scientific discovery",
  "type": "object",
  "required": ["project", "author", "events"],
  "properties": {
    "project": {
      "type": "object",
      "required": ["name", "description", "domain"],
      "properties": {
        "name": {
          "type": "string",
          "description": "Project name"
        },
        "description": {
          "type": "string",
          "description": "Brief project description"
        },
        "domain": {
          "type": "string",
          "description": "Research domain (e.g., quantum, biology, ml, physics, chemistry, materials, computer_science, other)"
        }
      }
    },
    "author": {
      "type": "object",
      "required": ["name", "affiliation", "background", "ai_role"],
      "properties": {
        "name": {
          "type": "string",
          "description": "Author name"
        },
        "affiliation": {
          "type": "string",
          "description": "Institutional affiliation (or 'independent')"
        },
        "orcid": {
          "type": "string",
          "format": "uri",
          "description": "ORCID identifier"
        },
        "background": {
          "type": "string",
          "description": "Academic background / credentials"
        },
        "ai_role": {
          "type": "string",
          "description": "Role of AI in the research process (e.g., cognitive_prosthesis, co_pilot, autonomous_agent)"
        }
      }
    },
    "events": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["id", "type", "date", "description"],
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^T([0-9]+|n)$|^(pivot|control|submission|publication|milestone)$",
            "description": "Event identifier (T0, T1, T2, Tn, pivot, control, submission, publication, milestone)"
          },
          "type": {
            "type": "string",
            "description": "Event type (free text, e.g., T0, T1, experiment, pivot, control, submission, publication, milestone)"
          },
          "date": {
            "type": "string",
            "format": "date",
            "description": "Event date (ISO 8601)"
          },
          "description": {
            "type": "string",
            "description": "Human-readable description of the event"
          },
          "tags": {
            "type": "array",
            "items": {
              "type": "string"
            },
            "description": "Tags for categorization"
          },
          "metrics": {
            "type": "object",
            "description": "Quantitative metrics for the event (arbitrary key-value pairs)",
            "additionalProperties": {
              "type": ["number", "string", "boolean", "null"]
            }
          },
          "evidence": {
            "type": "object",
            "description": "Supporting evidence for the event",
            "properties": {
              "git_commit": {
                "type": "string",
                "description": "Git commit hash"
              },
              "job_ids": {
                "type": "array",
                "items": {
                  "type": "string"
                },
                "description": "Related job IDs"
              },
              "data_links": {
                "type": "array",
                "items": {
                  "type": "string",
                  "format": "uri"
                },
                "description": "Links to data repositories"
              },
              "code_links": {
                "type": "array",
                "items": {
                  "type": "string",
                  "format": "uri"
                },
                "description": "Links to code repositories"
              }
            },
            "additionalProperties": {
              "type": ["string", "number", "boolean", "null"],
              "description": "Additional evidence fields"
            }
          }
        }
      }
    }
  }
}